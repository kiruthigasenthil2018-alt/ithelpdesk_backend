# Copy to .env and fill in YOUR keys. NEVER commit .env or share it in screenshots.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Security ----------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (min 32 chars; REQUIRED when APP_ENV=production)
SECRET_KEY=
ACCESS_TOKEN_MINUTES=120
# First admin account, created at startup if both are set. Change the password!
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe-Admin-123
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- AI providers (all free tiers) ----------
# Providers are tried in this order. If one hits its rate limit / quota / is down,
# the next one answers automatically, and the limited one is skipped for a minute.
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# 1) Gemini  - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2) Groq  - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter  - https://openrouter.ai/keys   (free models end in ":free"; names change, check the site)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
PROVIDER_COOLDOWN_SECONDS=60

# ---------- Database / cache ----------
# Local dev (no Docker): SQLite. Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./helpdesk.db
# PostgreSQL example: postgresql+psycopg2://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=
# Redis example: redis://localhost:6379/0   (empty = in-memory cache)

# ---------- RAG ----------
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
KNOWLEDGE_BASE_DIR=./knowledge_base
MIN_RELEVANCE=0.30

# File attachments (any format, max size per file in MB)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
